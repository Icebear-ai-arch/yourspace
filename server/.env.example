NODE_ENV=production
CLIENT_ORIGIN=https://yourspace-mu.vercel.app
SESSION_SECRET=replace-with-a-long-random-secret
DB_HOST=your-tidb-host
DB_PORT=4000
DB_USER=your-tidb-user
DB_PASSWORD=your-new-tidb-password
DB_NAME=test
DB_SSL_CA=paste-the-TiDB-CA-certificate-here
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=YourSpace <no-reply@example.com>
# Set this to the Render persistent disk path, for example /var/data/uploads.
# MEDIA_STORAGE_PATH=/var/data/uploads
